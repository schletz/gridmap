{
  "name": "gridmap",
  "version": "2.0.0",
  "description": "Kartenblick - Leaflet based map tool with grids, distance circles, markers and sun path",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "qrious": "^4.0.2",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/suncalc": "^1.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
